# DATABASE_URL=mssql+pyodbc://sa:YourStrong!Passw0rd@localhost:1433/purchase_order?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Encrypt=no
DATABASE_URL=
