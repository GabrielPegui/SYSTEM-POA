# Copy this file to .env and adjust the values for your environment.
# Never commit the real .env file.

APP_NAME=Purchase Order Automation API
APP_VERSION=0.1.0
ENVIRONMENT=development
# Namespaced debug flag. Uses APP_DEBUG instead of the generic DEBUG variable,
# which external tooling (Node debug package, CI systems) may set in the host
# environment and would otherwise break boolean validation.
APP_DEBUG=true
LOG_LEVEL=INFO

# Maximum accepted size for an uploaded purchase order PDF (megabytes).
MAX_UPLOAD_MB=20

# Microsoft SQL Server connection string (SQLAlchemy + pyodbc).
# Example for local development (docker-compose service "mssql"):
# DATABASE_URL=mssql+pyodbc://sa:YourStrong!Passw0rd@localhost:1433/purchase_order?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Encrypt=no
#
# This URL is also used by the versioned migrations. From the Backend folder:
#   python -m app.database.create_database   # create the database if missing
#   alembic upgrade head                     # apply migrations
DATABASE_URL=
