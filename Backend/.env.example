# Copy this file to .env and adjust the values for your environment.
# Never commit the real .env file.

APP_NAME=Purchase Order Automation API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Microsoft SQL Server connection string (SQLAlchemy + pyodbc).
